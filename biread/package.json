{
  "name": "zotero-paragraph-reader",
  "version": "0.1.6",
  "description": "Paragraph reflow, bilingual translation and linked Zotero annotations",
  "config": {
    "addonName": "Paragraph Reader · 段落阅读",
    "addonID": "paragraph-reader@yexun.local",
    "addonRef": "paragraphreader",
    "prefsPrefix": "extensions.zotero.ParagraphReader",
    "addonInstance": "ParagraphReader"
  },
  "main": "src/index.ts",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyyu1/zotero-paragraph-reader.git",
    "directory": "biread"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && node build-local.mjs",
    "release": "echo Release automation is disabled pending manual review.",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "lint": "prettier --write . && eslint . --fix",
    "lint:check": "prettier --check . && eslint .",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save",
    "test:bilingual": "node --test test/paragraph-flow.test.mjs test/region-layout.test.mjs test/bilingual-core.test.mjs test/annotation-bridge.test.mjs test/annotation-range.test.mjs test/annotation-provider.test.mjs test/local-model-install.test.mjs test/portable-reader.test.mjs test/model-layout.test.mjs test/reference-links.test.mjs test/paper-guide.test.mjs",
    "test:personal": "node --test test/personal-reader.test.mjs"
  },
  "author": "Personal fork; based on BiRead by WWeiyiWang and zotero-pdf-translate by windingwind and contributors",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/zyyu1/zotero-paragraph-reader#readme",
  "dependencies": {
    "franc": "^6.2.0",
    "iso639-js": "^1.1.3",
    "jsencrypt": "^3.5.0",
    "katex": "^0.16.25",
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.16.5",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.3"
  }
}
